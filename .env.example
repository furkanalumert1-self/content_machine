# Bu dosya yalnızca değişken ADLARINI gösterir. Gerçek değerleri buraya YAZMAYIN.
# Gerçek değerler: Vercel > Settings > Environment Variables ve GitHub > Settings > Secrets and variables > Actions.

# --- Supabase
SUPABASE_URL=https://ornek-proje.supabase.co
SUPABASE_ANON_KEY=ornek-anon-anahtar           # tarayıcıda kullanılabilir (RLS korur)
SUPABASE_SERVICE_ROLE_KEY=ornek-gizli-anahtar  # GİZLİ: sadece sunucu/Actions
ADMIN_EMAIL=siz@ornek.com                      # panele girebilecek tek hesap

# --- Instagram (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=0000000000
INSTAGRAM_APP_SECRET=ornek-gizli               # GİZLİ
INSTAGRAM_REDIRECT_URI=https://panel-adi.vercel.app/api/instagram/callback
TOKEN_ENCRYPTION_KEY=ornek-32-bayt-anahtar     # GİZLİ: Instagram token'ı veritabanında şifreli saklanır

# --- GitHub
GH_PRODUCT_READ_TOKEN=ornek                    # GİZLİ: ürün repoları, yalnızca Contents:Read + Metadata:Read
GH_DISPATCH_TOKEN=ornek                        # GİZLİ: sadece content_machine, Actions:Read/Write
GH_AUTOMATION_REPO=kullanici/content_machine

# --- Vercel
VERCEL_TOKEN=ornek                             # GİZLİ: proje/deployment okuma
VERCEL_TEAM_ID=

# --- Bildirim (Telegram)
TELEGRAM_BOT_TOKEN=ornek                       # GİZLİ
TELEGRAM_CHAT_ID=0

# --- Davranış (veritabanındaki ayarlar önceliklidir; bunlar ilk kurulum varsayılanı)
MODE=approval
PAUSED=false
